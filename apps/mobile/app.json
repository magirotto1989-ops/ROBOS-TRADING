{
  "expo": {
    "name": "Clínica",
    "slug": "clinic-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "clinic",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#06B6D4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clinic.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06B6D4"
      },
      "package": "com.clinic.app"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
